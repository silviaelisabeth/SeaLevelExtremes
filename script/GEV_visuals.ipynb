   "cell_type": "markdown",
   "id": "f9c6a5c7",
   "metadata": {},
   "source": [
    "## μ Regression - Non-stationary vs annual stationary per location\n",
    "\n",
    "compute with standardized or non-standardized years"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4ad98f42",
   "metadata": {},
   "source": [
    "##### Compute for 1 Location"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1c75e583",
   "metadata": {},
   "outputs": [],
   "source": [
    "ls_missing = []\n",
    "loc_id = random.choice(list(results_annual_stat_all.keys()))\n",
    "\n",
    "print(f'Compute regression analysis for μ₁ for site {loc_id}...')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1a37fe53",
   "metadata": {},
   "outputs": [],
   "source": [
    "if results_nonstat_all[loc_id] is None:\n",
    "    ls_missing.append(loc_id)\n",
    "    print(f'Could not process side {loc_id}, NO nonstationary results available (counting {len(ls_missing)})')\n",
    "\n",
    "years_, dic_trend = gev.prepare_for_regression(    \n",
    "    annual_stationary=results_annual_stat_all[loc_id], \n",
    "    nonstationary=results_nonstat_all[loc_id],\n",
    "    confidence_level_pc=CONFIDENCE_INTERVAL, factor_m_to_mm=1000,\n",
    "    years_scaled=True\n",
    "    ) "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f96db727",
   "metadata": {},
   "outputs": [],
   "source": [
    "fig_reg = dbplt.plot_location_regression(\n",
    "    loc_id, years_, dic_trend, results_annual_stat_all[loc_id], \n",
    "    confidence_level_pc=CONFIDENCE_INTERVAL, display_results=True, years_scaled=True,\n",
    "    axes_color='#333333', markers_color=\"#99E3DDFF\", colors_reg=['#CAA5C2FF', '#005C55FF'], \n",
    "    fontsize=12, \n",
    "    )"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "918c5b7c",
   "metadata": {},
   "source": [
    "#### Compute for All"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "414a7a77",
   "metadata": {},
   "outputs": [],
   "source": [
    "dic_fig_regression = {}\n",
    "ls_missing = []\n",
    "for loc_id in results_annual_stat_all.keys():\n",
    "    if loc_id >= start_location and loc_id <= end_location:\n",
    "        print(f'processing site {loc_id}...')\n",
    "        \n",
    "        if results_nonstat_all[loc_id] is None:\n",
    "            ls_missing.append(loc_id)\n",
    "            print(f'Skipping side {loc_id}, no nonstationary results (counting {len(ls_missing)})')\n",
    "            dic_fig_regression[loc_id] = None\n",
    "            continue\n",
    "        \n",
    "        years_, dic_trend = gev.prepare_for_regression(            \n",
    "            annual_stationary=results_annual_stat_all[loc_id], nonstationary=results_nonstat_all[loc_id],\n",
    "            confidence_level_pc=CONFIDENCE_INTERVAL, factor_m_to_mm=1000, years_scaled=True\n",
    "            ) \n",
    "\n",
    "        fig_reg = dbplt.plot_location_regression(\n",
    "            loc_id, years_, dic_trend, results_annual_stat_all[loc_id], fontsize=12,\n",
    "            confidence_level_pc=CONFIDENCE_INTERVAL, years_scaled=True,\n",
    "            axes_color='#333333', markers_color=\"#99E3DDFF\", colors_reg=['#CAA5C2FF',  '#005C55FF'], \n",
    "            )\n",
    "        \n",
    "        dic_fig_regression[loc_id] = fig_reg"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "480477c0",
   "metadata": {},
   "outputs": [],
   "source": [
