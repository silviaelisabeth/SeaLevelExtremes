    "            <br>\n",
    "            <b>Transparency</b><br>\n",
    "            Higher uncertainty → higher transparency\n",
    "        </div>\n",
    "        \"\"\"\n",
    "    #    More transparent → higher uncertainty\n",
    "    # ALTERNATIVE: bigger marker size → higher uncertainty\n",
    "\n",
    "    return legend_html\n",
    "\n"
